# ── Shiprocket Custom Checkout ────────────────────────────────────────────
# Inbound auth — checked against the x-api-key header on requests Shiprocket
# sends TO us (app/api/shiprocket/products GET feed).
SHIPROCKET_CATALOG_API_KEY=

# Outbound auth — sent BY us on webhook calls we make TO Shiprocket whenever
# a product or collection changes (lib/shiprocket-webhooks.ts). Both must be
# set for outbound webhooks to actually fire; until then they skip silently.
SHIPROCKET_WEBHOOK_API_KEY=
SHIPROCKET_WEBHOOK_SECRET=

# Base URL for outbound Shiprocket webhook calls. Defaults to production if
# unset — override with a staging URL when testing against a sandbox.
SHIPROCKET_WEBHOOK_BASE_URL=https://checkout-api.shiprocket.com

# Inbound auth for Shiprocket's Order Webhook (fires when a customer
# completes checkout on their Custom Checkout widget) — this one is a URL
# PATH SEGMENT, not a header, because Shiprocket's Order Webhook docs don't
# support a custom auth header the way the product feed above does. Register
# the webhook URL with Shiprocket as:
#   https://nezalherbocare.com/api/shiprocket/order-webhook/<this value>
# Generate a real value yourself with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHIPROCKET_ORDER_WEBHOOK_SECRET=

# Fallback shipping-label email when an order has neither a guest email nor
# an address email (lib/shiprocket.ts createShiprocketOrderForOrder).
# Defaults to orders@nezalherbocare.com if unset.
SHIPROCKET_FALLBACK_EMAIL=

# Outbound auth for starting a Shiprocket Custom Checkout session (the
# Access Token / Checkout call — lib/shiprocket-checkout.ts, called from
# app/api/shiprocket/initiate-checkout). Kept separate from
# SHIPROCKET_WEBHOOK_API_KEY/SECRET above even though Shiprocket MAY issue
# the same key for both — confirm with Shiprocket; either way these are
# independent env vars so one can be rotated without the other.
SHIPROCKET_CHECKOUT_API_KEY=
SHIPROCKET_CHECKOUT_API_SECRET=
